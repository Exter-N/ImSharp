<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <LangVersion>preview</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Deterministic>true</Deterministic>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

        <FileVersion>1.0.0.0</FileVersion>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>

        <DefineConstants>STATECHECKS;$(DefineConstants)</DefineConstants>
        <DefineConstants>IMPLOT;$(DefineConstants)</DefineConstants>
        <!--<DefineConstants>IMNODES;$(DefineConstants)</DefineConstants>-->
    </PropertyGroup>

    <ItemGroup>
      <Compile Remove="Extended\Classes\Table\**" />
      <EmbeddedResource Remove="Extended\Classes\Table\**" />
      <None Remove="Extended\Classes\Table\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2024.2.0" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0" />
        <PackageReference Include="System.IO.Hashing" Version="9.0" />
    </ItemGroup>

    <ItemGroup>
        <None Update="lib/cimgui.dll">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <TargetPath>cimgui.dll</TargetPath>
        </None>
        <None Update="lib/cimnodes.dll" Condition="$(DefineConstants.Contains(IMNODES))">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <TargetPath>cimnodes.dll</TargetPath>
        </None>
    </ItemGroup>
</Project>
